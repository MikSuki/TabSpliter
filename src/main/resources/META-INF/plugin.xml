<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.miksuki.TabSplitter</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>TabSplitter</name>
    <version>1.0.3</version>
    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="miksuki.hu@gmail.com" url="https://github.com/miksuki">MikSuki</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->

    <change-notes><![CDATA[
<h3>Version 1.0.3</h3>
<ul>
  <li><b>New</b>: Set until version to all future builds </li>
</ul>

<h3>Version 1.0.2</h3>
<ul>
  <li><b>Fixed</b>: Tab Switcher crashes when opening a project and selecting to overwrite the current window</li>
</ul>

<h3>Version 1.0.1</h3>
<ul>
  <li><b>New</b>: Added feature to open last used file when moving files between tabs</li>
  <li><b>Fixed</b>: Tab switching now correctly maintains project isolation</li>
  <li><b>Fixed</b>: Eliminated errors when selecting non-existent tabs</li>
  <li><b>Fixed</b>: Corrected tab counter functionality</li>
  <li><b>Fixed</b>: Updated toggle maximum tab description text</li>
</ul>
]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.miksuki.tabspliter.service.ProjectStartup"/>
    </extensions>

    <projectListeners>
        <listener class="com.miksuki.tabspliter.event.FileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
        />
    </projectListeners>

    <actions>
        <action id="prepare_and_switch_tab_next" text="Switch to next file" class="com.miksuki.tabspliter.event.PrepareAndSwitchTabNext"
        >
            <keyboard-shortcut first-keystroke="ctrl TAB"  keymap="$default"/>
        </action>
        <action id="prepare_and_switch_tab_previous" text="Switch to previous file" class="com.miksuki.tabspliter.event.PrepareAndSwitchTabPrevious"
        >
            <keyboard-shortcut first-keystroke="ctrl shift TAB"  keymap="$default"/>
        </action>
        <action id="switch_tab_next" text="Switch to previous file(when switching)" class="com.miksuki.tabspliter.event.SwitchTabPrevios"
        >
            <keyboard-shortcut first-keystroke="ctrl UP"  keymap="$default"/>
        </action>
        <action id="switch_tab_previous" text="Switch to next file(when switching)" class="com.miksuki.tabspliter.event.SwitchTabNext"
        >
            <keyboard-shortcut first-keystroke="ctrl DOWN"  keymap="$default"/>
        </action>
        <action id="move_tab_right" text="Move file right" class="com.miksuki.tabspliter.event.MoveFileRight"
        >
            <keyboard-shortcut first-keystroke="alt RIGHT"  keymap="$default"/>
        </action>
        <action id="move_tab_left" text="Move file left" class="com.miksuki.tabspliter.event.MoveFileLeft"
        >
            <keyboard-shortcut first-keystroke="alt LEFT"  keymap="$default"/>
        </action>
        <action id="move_to_1" text="Select Tab 1" class="com.miksuki.tabspliter.event.MoveToFisrtTab"
            >
            <keyboard-shortcut first-keystroke="control 1"  keymap="$default"/>
        </action>
        <action id="move_to_2" text="Select Tab 2" class="com.miksuki.tabspliter.event.MoveToSecondTab"
        >
            <keyboard-shortcut first-keystroke="control 2"  keymap="$default"/>
        </action>
        <action id="move_to_3" text="Select Tab 3" class="com.miksuki.tabspliter.event.MoveToThirdTab"
        >
            <keyboard-shortcut first-keystroke="control 3"  keymap="$default"/>
        </action>
        <action id="move_to_4" text="Select Tab 4" class="com.miksuki.tabspliter.event.MoveToFourthTab"
        >
            <keyboard-shortcut first-keystroke="control 4"  keymap="$default"/>
        </action>
        <action id="move_to_5" text="Select Tab 5" class="com.miksuki.tabspliter.event.MoveToFifthTab"
        >
            <keyboard-shortcut first-keystroke="control 5"  keymap="$default"/>
        </action>
        <action id="move_to_6" text="Select Tab 6" class="com.miksuki.tabspliter.event.MoveToSixthTab"
        >
            <keyboard-shortcut first-keystroke="control 6"  keymap="$default"/>
        </action>
        <action id="move_to_7" text="Select Tab 7" class="com.miksuki.tabspliter.event.MoveToSeventhTab"
        >
            <keyboard-shortcut first-keystroke="control 7"  keymap="$default"/>
        </action>
        <action id="move_to_8" text="Select Tab 8" class="com.miksuki.tabspliter.event.MoveToEighthTab"
        >
            <keyboard-shortcut first-keystroke="control 8"  keymap="$default"/>
        </action>
        <action id="move_to_9" text="Select Tab 9" class="com.miksuki.tabspliter.event.MoveToNinthTab"
        >
            <keyboard-shortcut first-keystroke="control 9"  keymap="$default"/>
        </action>
        <action id="toggle_current_tab_size" text="Toggle Current Tab Size" class="com.miksuki.tabspliter.event.ToggleCurrentTabSize"
        >
            <keyboard-shortcut first-keystroke="alt t"  keymap="$default"/>
        </action>
    </actions>
</idea-plugin>